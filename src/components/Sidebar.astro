---
import { getCollection } from 'astro:content';
import { groupPostsBySeries, getSeriesDisplayName, createSeriesHierarchy, getSeriesName } from '../utils/series';
import { PostTreeView } from './PostTreeView';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const { standalone, series } = groupPostsBySeries(allPosts);
const seriesHierarchy = createSeriesHierarchy(series);

// Get latest posts - mix of all posts including series episodes
const latestPosts = allPosts.slice(0, 5);

const currentPath = Astro.url.pathname;

// Check if current page is a series post
let currentSeriesKey = '';
for (const [key, seriesGroup] of series) {
	if (seriesGroup.posts.some(post => `/${post.id}/` === currentPath)) {
		currentSeriesKey = key;
		break;
	}
}
---

<aside class="hidden lg:block w-64 border-r border-gray-200 dark:border-gray-700 min-h-screen p-6 bg-white dark:bg-gray-900 flex-shrink-0">
	{/* Blog Home Link */}
	<div class="mb-6">
		<a
			href="/"
			class={`block py-2 text-sm text-gray-600 dark:text-gray-400 transition-all ${
				currentPath === "/"
					? "font-bold"
					: "hover:underline hover:font-semibold hover:decoration-red-700 dark:hover:decoration-red-400"
			}`}
		>
			Index
		</a>
	</div>

	{/* Latest Posts - includes all posts */}
	<div class="mb-6">
		<h3 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-3">Latest Posts</h3>
		<nav class="space-y-1">
			{latestPosts.map((post) => {
				const seriesName = getSeriesName(post);
				const displayName = seriesName ? getSeriesDisplayName(post) : post.data.title;
				const isActive = `/${post.id}/` === currentPath;
				return (
					<a
						href={`/${post.id}/`}
						class={`block px-3 py-2 text-sm rounded-md transition-colors truncate ${
							isActive
								? "bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 font-medium"
								: "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white"
						}`}
						title={displayName}
					>
						{displayName}
					</a>
				);
			})}
		</nav>
	</div>
	
	{/* Series Section with expandable navigation */}
	{seriesHierarchy.length > 0 && (
		<div>
			<h3 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-3">Series</h3>
			<nav class="space-y-2">
				{seriesHierarchy.map((seriesGroup) => {
					const seriesKey = seriesGroup.posts[0]?.data.series || seriesGroup.path.join('/');
					const isExpanded = currentSeriesKey === seriesKey;
					const seriesId = `series-${seriesKey.replace(/[^a-zA-Z0-9]/g, '-')}`;
					
					return (
						<div class="series-group">
							<button
								class="w-full flex items-center gap-1 px-3 py-2 text-sm rounded-md transition-colors hover:bg-gray-50 dark:hover:bg-gray-800 group"
								onclick={`document.getElementById('${seriesId}').classList.toggle('hidden'); document.getElementById('${seriesId}-arrow').classList.toggle('rotate-90')`}
							>
								<svg 
									id={`${seriesId}-arrow`}
									class={`w-3 h-3 text-gray-400 transition-transform ${isExpanded ? 'rotate-90' : ''}`} 
									fill="none" 
									stroke="currentColor" 
									viewBox="0 0 24 24"
								>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
								</svg>
								<svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
								</svg>
								<span class="flex-1 text-left text-xs font-medium text-gray-700 dark:text-gray-300 group-hover:text-gray-900 dark:group-hover:text-white">
									{seriesGroup.displayName || `${seriesGroup.parent ? `${seriesGroup.parent} / ` : ''}${seriesGroup.name}`}
								</span>
								<span class="text-xs text-gray-400 dark:text-gray-500">
									{seriesGroup.posts.length}
								</span>
							</button>
							<div id={seriesId} class={`ml-4 mt-1 space-y-1 ${!isExpanded ? 'hidden' : ''}`}>
								{seriesGroup.posts.map((post, index) => {
									const displayName = getSeriesDisplayName(post);
									const isActive = `/${post.id}/` === currentPath;
									return (
										<a
											href={`/${post.id}/`}
											class={`flex items-center gap-2 px-3 py-1.5 text-sm rounded-md transition-colors ${
												isActive
													? "bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 font-medium"
													: "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white"
											}`}
										>
											<span class="text-xs text-gray-400 dark:text-gray-500 w-4">{index + 1}.</span>
											<span class="flex-1 truncate" title={displayName}>{displayName}</span>
										</a>
									);
								})}
							</div>
						</div>
					);
				})}
			</nav>
		</div>
	)}

	{/* All Posts Section with Tree View */}
	<div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
		<h3 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-3">All Posts</h3>
		<PostTreeView 
			posts={allPosts} 
			currentPath={currentPath}
			standalone={standalone}
			series={series}
			client:load
		/>
	</div>
</aside>

<style>
	.series-group button:hover svg {
		color: rgb(107 114 128);
	}
	
	.dark .series-group button:hover svg {
		color: rgb(209 213 219);
	}
</style>