---
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import SearchComponent from './SearchComponent';
import { groupPostsBySeries, getSeriesDisplayName, createSeriesHierarchy, getSeriesName } from '../utils/series';
import { PostTreeView } from './PostTreeView';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const { standalone, series } = groupPostsBySeries(allPosts);
const seriesHierarchy = createSeriesHierarchy(series);

// Get latest posts - mix of all posts including series episodes
const latestPosts = allPosts.slice(0, 5);

// Get current path for active state
const currentPath = Astro.url.pathname;

// Check if current page is a series post
let currentSeriesKey = '';
for (const [key, seriesGroup] of series) {
	if (seriesGroup.posts.some(post => `/${post.id}/` === currentPath)) {
		currentSeriesKey = key;
		break;
	}
}
---

<header class="border-b border-gray-200 dark:border-gray-700 px-4 sm:px-6 py-4 bg-white dark:bg-gray-900 relative z-50">
	<div class="flex items-center justify-between max-w-7xl mx-auto">
		<div class="flex items-center gap-4">
			{/* Hamburger Menu Button - Only visible on mobile/tablet */}
			<button
				id="mobile-menu-button"
				class="lg:hidden p-2 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-md transition-colors"
				aria-label="Toggle menu"
			>
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
					<path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
			<a href="/" class="text-xl font-semibold text-black dark:text-white">
				{SITE_TITLE}
			</a>
		</div>
		<div class="flex items-center gap-4">
			<SearchComponent posts={allPosts} client:load />
		</div>
	</div>
</header>

{/* Mobile Navigation Drawer */}
<div id="mobile-menu" class="fixed inset-0 z-40 hidden">
	{/* Overlay */}
	<div id="mobile-menu-overlay" class="fixed inset-0 bg-black bg-opacity-50 transition-opacity"></div>
	
	{/* Drawer */}
	<nav class="fixed top-0 left-0 bottom-0 w-64 bg-white dark:bg-gray-900 shadow-xl transform -translate-x-full transition-transform duration-300 overflow-y-auto" id="mobile-menu-drawer">
		<div class="p-6 pt-20">
			{/* Close button */}
			<button
				id="mobile-menu-close"
				class="absolute top-4 right-4 p-2 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-md transition-colors"
				aria-label="Close menu"
			>
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
			
			{/* Navigation Links */}
			<div class="mb-6 space-y-2">
				<a
					href="/"
					class={`block py-2 text-sm text-gray-600 dark:text-gray-400 transition-all ${
						currentPath === "/"
							? "font-bold"
							: "hover:underline hover:font-semibold hover:decoration-red-700 dark:hover:decoration-red-400"
					}`}
				>
					Index
				</a>
				<a
					href="/papers/"
					class={`block py-2 text-sm text-gray-600 dark:text-gray-400 transition-all ${
						currentPath === "/papers/" || currentPath.startsWith("/papers/")
							? "font-bold"
							: "hover:underline hover:font-semibold hover:decoration-red-700 dark:hover:decoration-red-400"
					}`}
				>
					Papers
				</a>
			</div>
			
			{/* Latest Posts */}
			<div class="mb-6">
				<h3 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-3">Latest Posts</h3>
				<nav class="space-y-1">
					{latestPosts.map((post) => {
						const seriesName = getSeriesName(post);
						const displayName = seriesName ? getSeriesDisplayName(post) : post.data.title;
						const isActive = `/${post.id}/` === currentPath;
						return (
							<a
								href={`/${post.id}/`}
								class={`block px-3 py-2 text-sm rounded-md transition-colors truncate ${
									isActive
										? "bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 font-medium"
										: "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white"
								}`}
								title={displayName}
							>
								{displayName}
							</a>
						);
					})}
				</nav>
			</div>
			
			{/* Series Section with expandable navigation */}
			{seriesHierarchy.length > 0 && (
				<div class="mb-6">
					<h3 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-3">Series</h3>
					<nav class="space-y-2">
						{seriesHierarchy.map((seriesGroup) => {
							const seriesKey = seriesGroup.posts[0]?.data.series || seriesGroup.path.join('/');
							const isExpanded = currentSeriesKey === seriesKey;
							const seriesId = `mobile-series-${seriesKey.replace(/[^a-zA-Z0-9]/g, '-')}`;
							
							return (
								<div class="series-group">
									<button
										class="w-full flex items-center gap-1 px-3 py-2 text-sm rounded-md transition-colors hover:bg-gray-50 dark:hover:bg-gray-800 group"
										onclick={`document.getElementById('${seriesId}').classList.toggle('hidden'); document.getElementById('${seriesId}-arrow').classList.toggle('rotate-90')`}
									>
										<svg 
											id={`${seriesId}-arrow`}
											class={`w-3 h-3 text-gray-400 transition-transform ${isExpanded ? 'rotate-90' : ''}`} 
											fill="none" 
											stroke="currentColor" 
											viewBox="0 0 24 24"
										>
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
										</svg>
										<svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
										</svg>
										<span class="flex-1 text-left text-xs font-medium text-gray-700 dark:text-gray-300 group-hover:text-gray-900 dark:group-hover:text-white">
											{seriesGroup.displayName || `${seriesGroup.parent ? `${seriesGroup.parent} / ` : ''}${seriesGroup.name}`}
										</span>
										<span class="text-xs text-gray-400 dark:text-gray-500">
											{seriesGroup.posts.length}
										</span>
									</button>
									<div id={seriesId} class={`ml-4 mt-1 space-y-1 ${!isExpanded ? 'hidden' : ''}`}>
										{seriesGroup.posts.map((post, index) => {
											const displayName = getSeriesDisplayName(post);
											const isActive = `/${post.id}/` === currentPath;
											return (
												<a
													href={`/${post.id}/`}
													class={`flex items-center gap-2 px-3 py-1.5 text-sm rounded-md transition-colors ${
														isActive
															? "bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 font-medium"
															: "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white"
													}`}
												>
													<span class="text-xs text-gray-400 dark:text-gray-500 w-4">{index + 1}.</span>
													<span class="flex-1 truncate" title={displayName}>{displayName}</span>
												</a>
											);
										})}
									</div>
								</div>
							);
						})}
					</nav>
				</div>
			)}
			
			{/* All Posts Section with Tree View */}
			<div class="border-t border-gray-200 dark:border-gray-700 pt-6">
				<h3 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-3">All Posts</h3>
				<PostTreeView 
					posts={allPosts} 
					currentPath={currentPath}
					standalone={standalone}
					series={series}
					client:load
				/>
			</div>
		</div>
	</nav>
</div>

<script>
	// Mobile menu functionality
	const mobileMenuButton = document.getElementById('mobile-menu-button');
	const mobileMenu = document.getElementById('mobile-menu');
	const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');
	const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
	const mobileMenuClose = document.getElementById('mobile-menu-close');
	const menuIcon = document.getElementById('menu-icon');
	const closeIcon = document.getElementById('close-icon');
	
	function openMobileMenu() {
		mobileMenu?.classList.remove('hidden');
		setTimeout(() => {
			mobileMenuDrawer?.classList.remove('-translate-x-full');
		}, 10);
		menuIcon?.classList.add('hidden');
		closeIcon?.classList.remove('hidden');
		document.body.style.overflow = 'hidden';
	}
	
	function closeMobileMenu() {
		mobileMenuDrawer?.classList.add('-translate-x-full');
		setTimeout(() => {
			mobileMenu?.classList.add('hidden');
		}, 300);
		menuIcon?.classList.remove('hidden');
		closeIcon?.classList.add('hidden');
		document.body.style.overflow = '';
	}
	
	mobileMenuButton?.addEventListener('click', () => {
		if (mobileMenu?.classList.contains('hidden')) {
			openMobileMenu();
		} else {
			closeMobileMenu();
		}
	});
	
	mobileMenuClose?.addEventListener('click', closeMobileMenu);
	mobileMenuOverlay?.addEventListener('click', closeMobileMenu);
	
	// Close menu when clicking on a link
	const mobileMenuLinks = mobileMenu?.querySelectorAll('a');
	mobileMenuLinks?.forEach(link => {
		link.addEventListener('click', closeMobileMenu);
	});
	
	// Close menu on escape key
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !mobileMenu?.classList.contains('hidden')) {
			closeMobileMenu();
		}
	});
</script>

<style>
	.series-group button:hover svg {
		color: rgb(107 114 128);
	}
	
	.dark .series-group button:hover svg {
		color: rgb(209 213 219);
	}
</style>