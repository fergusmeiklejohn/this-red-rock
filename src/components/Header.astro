---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, TWITTER_URL } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Research</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href={TWITTER_URL} target="_blank" class="twitter-link">
				<span class="sr-only">Follow on X/Twitter</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="currentColor">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 2rem;
		background: white;
		border-bottom: 1px solid #f3f4f6;
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(8px);
	}

	h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: #111827;
		transition: color 0.2s ease;
	}

	h2 a:hover {
		color: #6366f1;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 4rem;
		max-width: 1200px;
		margin: 0 auto;
	}

	.internal-links {
		display: flex;
		gap: 2rem;
	}

	nav .internal-links a {
		padding: 0.5rem 0;
		color: #6b7280;
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-weight: 500;
		transition: all 0.2s ease;
		font-size: 0.95rem;
	}

	nav .internal-links a:hover,
	nav .internal-links a.active {
		color: #111827;
		border-bottom-color: #6366f1;
	}

	.social-links {
		display: flex;
	}

	.twitter-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.5rem;
		color: #6b7280;
		transition: all 0.2s ease;
		text-decoration: none;
	}

	.twitter-link:hover {
		background: #f3f4f6;
		color: #111827;
	}

	@media (max-width: 768px) {
		header {
			padding: 0 1rem;
		}

		nav {
			height: 3.5rem;
		}

		.internal-links {
			gap: 1rem;
		}

		.internal-links a {
			font-size: 0.9rem;
		}

		h2 {
			font-size: 1.125rem;
		}
	}

	@media (max-width: 640px) {
		.social-links {
			display: none;
		}
	}
</style>
