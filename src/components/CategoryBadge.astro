---
interface Props {
	category: string;
}

const { category } = Astro.props;

function getCategoryClasses(category: string) {
	// All categories now use the same styling as "General"
	return 'bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-600';
}
---

<span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium transition-colors ${getCategoryClasses(category)}`}>
	{category}
</span>