---
import { TWITTER_URL } from '../consts';
const today = new Date();
---

<footer>
	<div class="footer-content">
		<a href={TWITTER_URL} target="_blank" class="twitter-link">
			<span class="sr-only">Follow on X/Twitter</span>
			<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="currentColor">
				<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
			</svg>
		</a>
	</div>
</footer>

<style>
	footer {
		padding: 3rem 2rem;
		background: #fafafa;
		border-top: 1px solid #f3f4f6;
		margin-top: 4rem;
	}

	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.twitter-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.5rem;
		color: #9ca3af;
		transition: all 0.2s ease;
		text-decoration: none;
	}

	.twitter-link:hover {
		background: #f3f4f6;
		color: #111827;
	}

	@media (max-width: 768px) {
		footer {
			padding: 2rem 1rem;
		}
	}
</style>
