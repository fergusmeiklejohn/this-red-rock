---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 5); // Show only 5 most recent posts
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="min-h-screen bg-white">
		<Header />
		
		<div class="max-w-7xl mx-auto flex">
			<Sidebar />
			
			<main class="flex-1 p-6">
				<div class="mb-8">
					<h1 class="text-4xl font-bold text-black mb-4">Welcome</h1>
					<p class="text-gray-600 text-lg mb-8">
						Daily insights and research findings across various domains.
					</p>
				</div>

				<!-- Recent Posts -->
				<div class="mb-8">
					<div class="flex items-center justify-between mb-6">
						<h2 class="text-2xl font-semibold text-black">Recent Posts</h2>
						<a href="/blog" class="text-sm text-gray-600 hover:text-gray-900 transition-colors">
							View all →
						</a>
					</div>
					
					<div class="space-y-6">
						{posts.map((post) => (
							<article class="border-b border-gray-100 pb-6 last:border-b-0">
								<div class="flex items-start gap-4">
									<div class="flex-shrink-0">
										<CategoryBadge category={post.data.theme || 'General'} />
									</div>
									<div class="flex-1 min-w-0">
										<div class="text-sm text-gray-500 mb-2">
											<FormattedDate date={post.data.pubDate} />
										</div>
										<h3 class="text-lg font-semibold text-black mb-2 leading-tight">
											<a href={`/blog/${post.id}/`} class="hover:underline">
												{post.data.title}
											</a>
										</h3>
										<p class="text-gray-600 text-sm leading-relaxed">
											{post.data.excerpt || post.data.description}
										</p>
									</div>
								</div>
							</article>
						))}
					</div>
				</div>

				<!-- About Section -->
				<div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
					<h2 class="text-xl font-semibold text-black mb-3">About This Research</h2>
					<p class="text-gray-600 leading-relaxed mb-4">
						Welcome to my research blog. Here I share daily insights, findings, and thoughts 
						on various topics organized by themes and series. Each post represents a step 
						in the journey of understanding complex problems and developing solutions.
					</p>
					<a href="/about" class="inline-flex items-center text-sm text-gray-600 hover:text-gray-900 transition-colors">
						Learn more →
					</a>
				</div>
			</main>
		</div>
	</body>
</html>
