---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import heroImage from '../assets/this-red-rock.jpg';
import { groupPostsBySeries, getSeriesFromPath, getSeriesDisplayName, getSeriesName, createSeriesHierarchy } from '../utils/series';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const { standalone, series } = groupPostsBySeries(allPosts);
const seriesHierarchy = createSeriesHierarchy(series);

// Create a mixed list of posts and series for display
const displayItems: Array<{ type: 'post' | 'series', data: any }> = [];

// Add standalone posts
standalone.forEach(post => {
	displayItems.push({ type: 'post', data: post });
});

// Add only root-level series (hierarchical display)
seriesHierarchy.forEach((seriesGroup) => {
	displayItems.push({ type: 'series', data: { key: seriesGroup.path.join('/'), ...seriesGroup } });
});

// Ensure Claude's Research Diary is included even if nested
series.forEach((seriesGroup, key) => {
	if ((seriesGroup.displayName === "Claude's Research Diary" || key === "Claude's Research Diary") && 
	    !displayItems.some(item => item.type === 'series' && (item.data.displayName === "Claude's Research Diary" || item.data.key === "Claude's Research Diary"))) {
		displayItems.push({ type: 'series', data: { key, ...seriesGroup } });
	}
});

// Sort by most recent date
displayItems.sort((a, b) => {
	const aDate = a.type === 'post' 
		? a.data.data.pubDate 
		: Math.max(...a.data.posts.map(p => p.data.pubDate.valueOf()));
	const bDate = b.type === 'post' 
		? b.data.data.pubDate 
		: Math.max(...b.data.posts.map(p => p.data.pubDate.valueOf()));
	return new Date(bDate).valueOf() - new Date(aDate).valueOf();
});

// Get all unique themes for category tabs
const themes = [...new Set(allPosts.map(post => post.data.theme).filter(Boolean))];
const categories = ['All', ...themes, "Claude's Diary"];

// Helper to render nested series
function renderSeriesHierarchy(seriesMap: Map<string, any>) {
	const renderedKeys = new Set<string>();
	const result: Array<{ type: 'series', data: any }> = [];
	
	// First, get all series that should be at root level
	seriesMap.forEach((seriesGroup, key) => {
		if (!seriesGroup.parent || !seriesMap.has(seriesGroup.parent)) {
			result.push({ type: 'series', data: { key, ...seriesGroup, children: [] } });
			renderedKeys.add(key);
		}
	});
	
	// Then, nest child series
	seriesMap.forEach((seriesGroup, key) => {
		if (seriesGroup.parent && seriesMap.has(seriesGroup.parent) && !renderedKeys.has(key)) {
			const parentData = result.find(item => item.data.key === seriesGroup.parent);
			if (parentData) {
				parentData.data.children.push({ key, ...seriesGroup });
			}
		}
	});
	
	return result;
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="min-h-screen bg-white dark:bg-gray-900">
		<Header />
		
		<div class="max-w-7xl mx-auto">
			<!-- Hero Image -->
			<div class="w-full mb-6 lg:mb-8 relative overflow-hidden" style="max-height: 500px;">
				<Image 
					src={heroImage} 
					alt="This Red Rock"
					class="w-full h-auto object-cover"
					width={1920}
					height={400}
					loading="eager"
					format="webp"
					style="max-height: 500px;"
				/>
			</div>
		</div>
		
		<div class="max-w-7xl mx-auto flex">
			<Sidebar />
			
			<main class="flex-1 px-4 sm:px-6 lg:px-8 py-6 lg:py-8 min-w-0">
				<div class="mb-8">
					<h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-black dark:text-white mb-6 lg:mb-8">Blog</h1>

					<!-- Category Tabs -->
					<div class="mb-6">
						<div class="flex gap-1 overflow-x-auto scrollbar-hide" id="category-tabs">
							{categories.map((category) => (
								<button
									class={`px-3 sm:px-4 py-2 text-xs sm:text-sm transition-colors category-tab whitespace-nowrap flex-shrink-0 ${
										category === 'All' 
											? 'bg-black dark:bg-white text-white dark:text-black' 
											: 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'
									}`}
									data-category={category}
								>
									{category}
								</button>
							))}
						</div>
					</div>
				</div>

				<!-- Blog Posts -->
				<div class="space-y-8" id="posts-container">
					{displayItems.map((item) => {
						if (item.type === 'post') {
							const post = item.data;
							return (
								<article class="border-b border-gray-100 dark:border-gray-800 pb-8 last:border-b-0 post-item" data-theme={post.data.theme || 'General'} data-type="post">
									<div class="mb-3">
										<CategoryBadge category={post.data.theme || 'General'} />
									</div>
									<div class="text-sm text-gray-500 dark:text-gray-400 mb-2">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h2 class="text-lg sm:text-xl font-semibold text-black dark:text-white mb-3 leading-tight">
										<a href={`/${post.id}/`} class="hover:underline">
											{post.data.title}
										</a>
									</h2>
									<p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed">
										{post.data.excerpt || post.data.description}
									</p>
								</article>
							);
						} else {
							// Series group
							const seriesGroup = item.data;
							const latestPost = seriesGroup.posts[seriesGroup.posts.length - 1];
							const isClaudesDiary = seriesGroup.name === "Claude's Research Diary" || seriesGroup.displayName === "Claude's Research Diary";
							return (
								<article class="border-b border-gray-100 dark:border-gray-800 pb-8 last:border-b-0 post-item series-item" data-theme={latestPost.data.theme || 'General'} data-type="series" data-series-name={seriesGroup.displayName || seriesGroup.name} data-claude-diary={isClaudesDiary ? 'true' : 'false'}>
									<div class="mb-3 flex items-center gap-2">
										<CategoryBadge category={latestPost.data.theme || 'General'} />
										<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-50 text-red-700 dark:bg-red-900/20 dark:text-red-400" style="--tw-text-opacity: 1; color: rgb(214 3 1 / var(--tw-text-opacity))">
											<svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
											</svg>
											Series
										</span>
										<button class="series-toggle ml-auto text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 p-1" aria-label="Toggle series">
											<svg class="w-5 h-5 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
											</svg>
										</button>
									</div>
									<div class="mb-4">
										<h2 class="text-lg sm:text-xl font-semibold text-black dark:text-white mb-2 leading-tight">
											{seriesGroup.displayName || `${seriesGroup.parent ? `${seriesGroup.parent}: ` : ''}${seriesGroup.name}`}
										</h2>
										<div class="text-sm text-gray-500 dark:text-gray-400">
											{seriesGroup.posts.length} {seriesGroup.posts.length === 1 ? 'episode' : 'episodes'} • Latest: <FormattedDate date={latestPost.data.pubDate} />
										</div>
									</div>
									<div class={`series-content space-y-4 mt-4 ${isClaudesDiary ? '' : 'hidden'}`}>
										{seriesGroup.posts.map((post, index) => {
											const displayName = getSeriesDisplayName(post);
											const episodeMatch = post.id.match(/Day (\d+)/);
											const dayNumber = episodeMatch ? episodeMatch[1] : (index + 1);
											return (
												<div class={`${isClaudesDiary ? 'bg-gray-50 dark:bg-gray-800/50 p-4 rounded-lg border border-gray-200 dark:border-gray-700' : 'flex items-start gap-3'}`}>
													{isClaudesDiary ? (
														<>
															<div class="mb-2">
																<h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">
																	<a href={`/${post.id}/`} class="hover:underline">
																		{post.data.title}
																	</a>
																</h3>
																<div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
																	<FormattedDate date={post.data.pubDate} />
																</div>
															</div>
															<p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
																{post.data.description}
															</p>
														</>
													) : (
														<>
															<span class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">{index + 1}.</span>
															<div class="flex-1">
																<h3 class="text-sm font-medium text-gray-900 dark:text-gray-100">
																	<a href={`/${post.id}/`} class="hover:underline">
																		{displayName}
																	</a>
																</h3>
																<p class="text-xs text-gray-600 dark:text-gray-400 mt-1">
																	{post.data.description}
																</p>
															</div>
														</>
													)}
												</div>
											);
										})}
									</div>
								</article>
							);
						}
					})}
				</div>
			</main>
		</div>

		<script>
			// Category filtering and series expand/collapse functionality
			document.addEventListener('DOMContentLoaded', function() {
				const tabs = document.querySelectorAll('.category-tab');
				const posts = document.querySelectorAll('.post-item');
				const seriesItems = document.querySelectorAll('.series-item');

				// Series expand/collapse functionality
				seriesItems.forEach(seriesItem => {
					const toggleButton = seriesItem.querySelector('.series-toggle');
					const seriesContent = seriesItem.querySelector('.series-content');
					const toggleIcon = toggleButton.querySelector('svg');
					
					// Check if this is Claude's Diary (already expanded by default)
					const isClaudesDiary = seriesItem.getAttribute('data-claude-diary') === 'true';
					if (isClaudesDiary) {
						toggleIcon.classList.add('rotate-180');
					}
					
					toggleButton.addEventListener('click', function(e) {
						e.preventDefault();
						
						// Toggle visibility
						seriesContent.classList.toggle('hidden');
						
						// Rotate arrow
						toggleIcon.classList.toggle('rotate-180');
					});
				});

				// Category filtering
				tabs.forEach(tab => {
					tab.addEventListener('click', function() {
						const selectedCategory = this.getAttribute('data-category');
						
						// Update active tab
						tabs.forEach(t => {
							t.classList.remove('bg-black', 'text-white', 'dark:bg-white', 'dark:text-black');
							t.classList.add('text-gray-600', 'dark:text-gray-400', 'hover:text-gray-900', 'dark:hover:text-white');
						});
						this.classList.add('bg-black', 'text-white', 'dark:bg-white', 'dark:text-black');
						this.classList.remove('text-gray-600', 'dark:text-gray-400', 'hover:text-gray-900', 'dark:hover:text-white');
						
						// Filter posts
						posts.forEach(post => {
							const postTheme = post.getAttribute('data-theme');
							const postType = post.getAttribute('data-type');
							const isClaudesDiary = post.getAttribute('data-claude-diary') === 'true';
							
							if (selectedCategory === 'All') {
								post.style.display = 'block';
							} else if (selectedCategory === "Claude's Diary") {
								// Show only Claude's Research Diary series
								if (isClaudesDiary) {
									post.style.display = 'block';
									// Auto-expand Claude's Diary when its tab is selected
									const seriesContent = post.querySelector('.series-content');
									const toggleIcon = post.querySelector('.series-toggle svg');
									if (seriesContent && seriesContent.classList.contains('hidden')) {
										seriesContent.classList.remove('hidden');
										toggleIcon.classList.add('rotate-180');
									}
								} else {
									post.style.display = 'none';
								}
							} else if (postTheme === selectedCategory && postType !== 'series') {
								post.style.display = 'block';
							} else {
								post.style.display = 'none';
							}
						});
					});
				});
			});
		</script>
	</body>
</html>