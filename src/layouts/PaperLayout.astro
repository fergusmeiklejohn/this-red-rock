---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';

type Props = CollectionEntry<'papers'>['data'] & {
	relatedBlogPosts?: CollectionEntry<'blog'>[];
	relatedSeriesPosts?: CollectionEntry<'blog'>[];
};

const { 
	title, 
	abstract, 
	authors, 
	pubDate, 
	paperUrl, 
	codeUrl, 
	keywords, 
	citation, 
	venue,
	coverImage,
	relatedSeries,
	relatedBlogPosts = [],
	relatedSeriesPosts = []
} = Astro.props;

// Sort series posts by order
const sortedSeriesPosts = relatedSeriesPosts.sort((a, b) => 
	(a.data.seriesOrder || 0) - (b.data.seriesOrder || 0)
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={abstract} />
	</head>
	<body class="min-h-screen bg-white dark:bg-gray-900">
		<Header />
		
		<div class="max-w-7xl mx-auto flex">
			<Sidebar />
			
			<main class="flex-1 px-4 sm:px-6 lg:px-8 py-6 lg:py-8 min-w-0">
				<article class="prose prose-gray dark:prose-invert mx-auto max-w-4xl">
					{/* Paper Header */}
					<header class="mb-8 not-prose">
						<h1 class="text-3xl sm:text-4xl font-bold text-black dark:text-white mb-4">
							{title}
						</h1>
						
						<div class="text-sm text-gray-600 dark:text-gray-400 mb-4">
							<div class="mb-2">{authors.join(', ')}</div>
							<div class="flex flex-wrap gap-4">
								<FormattedDate date={pubDate} />
								{venue && <span>• {venue}</span>}
							</div>
						</div>
						
						{coverImage && (
							<div class="mb-6">
								<Image
									src={coverImage}
									alt={`Cover image for ${title}`}
									class="w-full rounded-lg"
									width={1200}
									height={630}
								/>
							</div>
						)}
						
						{/* Action Buttons */}
						<div class="flex flex-wrap gap-4 mb-6">
							{paperUrl && (
								<a 
									href={paperUrl} 
									class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 dark:bg-red-500 dark:hover:bg-red-600 transition-colors"
									target="_blank"
									rel="noopener noreferrer"
									style="color: white;"
								>
									<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
									</svg>
									Download PDF
								</a>
							)}
							{codeUrl && (
								<a 
									href={codeUrl} 
									class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
									target="_blank"
									rel="noopener noreferrer"
								>
									<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
									</svg>
									View Code
								</a>
							)}
						</div>
						
						{/* Abstract */}
						<div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-6 mb-6">
							<h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3">Abstract</h2>
							<p class="text-gray-700 dark:text-gray-300 leading-relaxed">
								{abstract}
							</p>
						</div>
						
						{/* Keywords */}
						{keywords.length > 0 && (
							<div class="mb-6">
								<h3 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-2">Keywords</h3>
								<div class="flex flex-wrap gap-2">
									{keywords.map((keyword) => (
										<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200">
											{keyword}
										</span>
									))}
								</div>
							</div>
						)}
					</header>
					
					{/* Paper Content */}
					<div class="mb-12">
						<slot />
					</div>
					
					{/* Citation */}
					{citation && (
						<div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-6 mb-8 not-prose">
							<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3">Citation</h3>
							<pre class="text-sm text-gray-700 dark:text-gray-300 whitespace-pre-wrap font-mono">{citation}</pre>
							<button 
								class="mt-3 text-sm text-red-600 dark:text-red-400 hover:underline"
								onclick={`navigator.clipboard.writeText(\`${citation}\`); this.textContent = 'Copied!'; setTimeout(() => this.textContent = 'Copy citation', 2000);`}
							>
								Copy citation
							</button>
						</div>
					)}
					
					{/* Related Content */}
					{(relatedSeries || relatedBlogPosts.length > 0) && (
						<div class="border-t border-gray-200 dark:border-gray-700 pt-8 not-prose">
							<h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-6">Related Content</h3>
							
							{/* Related Series */}
							{relatedSeries && sortedSeriesPosts.length > 0 && (
								<div class="mb-8">
									<h4 class="text-lg font-medium text-gray-800 dark:text-gray-200 mb-4">
										Research Diary: {relatedSeries}
									</h4>
									<div class="space-y-3">
										{sortedSeriesPosts.map((post) => (
											<a 
												href={`/${post.id}/`}
												class="block p-4 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600 transition-colors"
											>
												<div class="flex items-start gap-3">
													{post.data.seriesOrder && (
														<span class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">
															Day {post.data.seriesOrder}
														</span>
													)}
													<div class="flex-1">
														<h5 class="font-medium text-gray-900 dark:text-gray-100 mb-1">
															{post.data.title}
														</h5>
														<p class="text-sm text-gray-600 dark:text-gray-400">
															{post.data.description}
														</p>
													</div>
												</div>
											</a>
										))}
									</div>
								</div>
							)}
							
							{/* Other Related Posts */}
							{relatedBlogPosts.length > 0 && (
								<div>
									<h4 class="text-lg font-medium text-gray-800 dark:text-gray-200 mb-4">
										Related Blog Posts
									</h4>
									<div class="space-y-3">
										{relatedBlogPosts.map((post) => (
											<a 
												href={`/${post.id}/`}
												class="block p-4 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600 transition-colors"
											>
												<h5 class="font-medium text-gray-900 dark:text-gray-100 mb-1">
													{post.data.title}
												</h5>
												<p class="text-sm text-gray-600 dark:text-gray-400">
													{post.data.description}
												</p>
											</a>
										))}
									</div>
								</div>
							)}
						</div>
					)}
				</article>
			</main>
		</div>
	</body>
</html>